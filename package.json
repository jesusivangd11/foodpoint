{
  "name": "mesana",
  "version": "3.3.1",
  "description": "FoodPoint - Punto de venta para restaurantes (app de escritorio)",
  "main": "main.js",
  "author": "Jesus",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mesana.pos",
    "productName": "FoodPoint",
    "directories": {
      "output": "dist-installer"
    },
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "license.js",
      "cocina.html",
      "printing.js",
      "index.html",
      "foodpoint.ico",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "foodpoint.ico",
      "artifactName": "FoodPoint-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FoodPoint",
      "runAfterFinish": true,
      "license": "LICENCIA.txt",
      "include": "build/installer.nsh",
      "installerIcon": "foodpoint.ico",
      "uninstallerIcon": "foodpoint.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jesusivangd11",
        "repo": "mesana-releases",
        "releaseType": "release"
      }
    ],
    "copyright": "© 2026 FoodPoint"
  }
}
